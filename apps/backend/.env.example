PORT=5000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=lms_user
DB_PASSWORD=lms_password
DB_NAME=lms_db

# Access token secret — generate with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters

# Refresh token secret — generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-this-refresh-secret-with-different-32-char-value
